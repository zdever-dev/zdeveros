# ZdeVer OS — Backend Environment Variables
# Copy to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Database (SQLite path — for SaaS swap to Postgres URL)
DB_PATH=./data/zdever.db
# POSTGRES_URL=postgresql://user:password@localhost:5432/zdever

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# PDF output directory
PDF_OUTPUT_DIR=./data/pdfs

# App info (used in PDFs and emails)
APP_NAME=ZdeVer OS
APP_VERSION=1.0.0

# JWT Secret (for future auth module)
JWT_SECRET=change-this-to-a-random-secret-in-production
